# Copy this file to backend/.env and fill in your local values.
# backend/.env is git-ignored; it is only read when running the app locally from the backend folder.
DB_URL=jdbc:postgresql://localhost:5432/leaveflow_misl_assignment
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Optional overrides
# JWT_SECRET=<base64 encoded 32+ byte random key>
# JWT_ACCESS_TOKEN_EXPIRATION=15m
# JWT_REFRESH_TOKEN_EXPIRATION=7d
# JWT_COOKIE_SECURE=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173
