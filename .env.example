# Optional settings for docker-compose. Copy to .env (git-ignored) and change what you need.
# Every value has a working default in docker-compose.yml, so this file is not required.

POSTGRES_DB=leaveflow
POSTGRES_USER=leaveflow
POSTGRES_PASSWORD=leaveflow

# Base64-encoded 256-bit key for signing access tokens. Generate one with:
#   openssl rand -base64 32
# JWT_SECRET=

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_HOST_PORT=5433

# Load sample leave requests into an empty database
DEMO_DATA_ENABLED=true
